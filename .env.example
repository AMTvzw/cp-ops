# Database Configuration (default local SQLite)
# DB_CLIENT=sqlite3
# DB_FILENAME=data/cp_ops.sqlite

# Environment mode: development | test | production
NODE_ENV=development

# Session secret (required, min 32 chars)
SESSION_SECRET=replace-with-a-long-random-secret

# Session idle timeout in minutes (timer resets on every request)
SESSION_IDLE_TIMEOUT_MINUTES=30

# Optional Redis for shared rate limiting across multiple app instances
# REDIS_URL=redis://localhost:6379

# Optional upload directory (on Vercel, defaults to /tmp/uploads)
# UPLOAD_DIR=uploads

# Upload storage backend: fs | db
# On Vercel, defaults to db for persistence with external MariaDB/MySQL.
# UPLOAD_STORAGE=db

# Default root user (only used when no ROOT user exists yet)
DEFAULT_ROOT_USERNAME=root
DEFAULT_ROOT_PASSWORD=replace-this-password

# External MariaDB/MySQL via URL:
# DB_CLIENT=mysql2
# DB_URL=mysql://user:password@localhost:3306/cp_ops
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CONNECT_TIMEOUT_MS=15000
# DB_POOL_MIN=0
# DB_POOL_MAX=10
# DB_POOL_CREATE_TIMEOUT_MS=10000
# DB_POOL_ACQUIRE_TIMEOUT_MS=15000
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_REAP_INTERVAL_MS=1000
# DB_ACQUIRE_CONNECTION_TIMEOUT_MS=15000

# External MariaDB/MySQL via separate values:
# DB_CLIENT=mysql2
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=cp_ops
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CONNECT_TIMEOUT_MS=15000
# DB_POOL_MIN=0
# DB_POOL_MAX=10
# DB_POOL_CREATE_TIMEOUT_MS=10000
# DB_POOL_ACQUIRE_TIMEOUT_MS=15000
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_REAP_INTERVAL_MS=1000
# DB_ACQUIRE_CONNECTION_TIMEOUT_MS=15000
